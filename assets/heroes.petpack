petpack 1
id = heroes
name = Pixel heroes
by = the Pixel Pet project
about = The heroes and villains that come with Pixel Pet. Made up and drawn for it. docs/PACKS.md says how to write a pack of your own.

colour 0 = #2b2f4a
colour 1 = #ffd23f
colour 2 = #d99a00
colour 3 = #c89b3c
colour 4 = #8a6424
colour 5 = #8d99a6
colour 6 = #6a7580
colour 7 = #5f9e58
colour 8 = #2ec4b6
colour 9 = #178a80
colour @ = #7a4fa3
colour % = #55347a
colour & = #ffb3c7
colour $ = #d94f8a
colour * = #4a4650
colour + = #ff6a2a
colour ~ = #bfe9ff
colour ! = #9aa0a8
colour ? = #c9ced6
colour ^ = #e8632b

[tool lantern]
grip = 2 5
art =
| ..K..
| .KKK.
| KYYYK
| KYiYK
| KYYYK
| .KKK.

[tool umbrella]
grip = 1 6
art =
| .K.
| KRK
| KRK
| KRK
| KrK
| .K.
| .K.
| KK.

[tool ladle]
grip = 1 6
art =
| .KK.
| KVVK
| KnVK
| .KK.
| .KV.
| .KV.
| .KV.
| .KK.

[tool quill]
grip = 1 6
art =
| ...KK
| ..KiK
| ..KiK
| .KiiK
| .KiK.
| .KGK.
| KGK..
| KK...

# Holds the lantern up until everything is lit.
[move lamplight]
secs = 2.6
puff = spark 0.2
dy = 0:0 0.6:2.4 1.4:2 2:2.4 2.6:0
arm1 = 0:10 0.5:40 2.1:40 2.6:10
arm2 = 0:10 0.5:150 2.1:150 2.6:10
aura = 0:0 0.6:0.9 2:0.9 2.55:0
wing = 0:0 0.5:1 2.1:1 2.6:0
eyes = 0:open 0.4:happy 2.3:open
fx = 0:none 0.4:orbs,0,0 0.9:orbs,1,0.8 2:orbs,1,2.4 2.45:orbs,0,3 2.5:none

# Jumps into a puddle.
[move splash]
secs = 1.6
hit = ground 0.6
puff = shards 0.09 0.6 1.1
dy = 0:0 0.15:-0.4 0.35:5 0.6:0 1.6:0
sy = 0:1 0.15:0.86 0.3:1.08 0.6:0.74 0.85:1.05 1.1:1
sx = 0:1 0.6:1.14 0.85:0.98 1.1:1
arm1 = 0:10 0.35:150 0.6:150 1.1:60 1.6:10
arm2 = 0:10 0.35:150 0.6:150 1.1:60 1.6:10
leg1 = 0:0 0.35:-0.8 0.6:0
leg2 = 0:0 0.35:0.8 0.6:0
mouth = 0:0 0.35:0.8 0.9:0.6 1.4:0
eyes = 0:open 0.3:happy 1.4:open
fx = 0:none 0.6:ring,0.05 1.3:ring,0.95 1.31:none

# Turns the clock back.
[move rewind]
secs = 2.4
puff = trail 0.12
dy = 0:0 0.4:3.5 1.9:3.5 2.3:0 2.4:0
rot = 0:0 0.35:8 1.85:-720 2.4:-720
pivot = 0:0.5
arm1 = 0:10 0.4:95 1.9:95 2.4:10
arm2 = 0:10 0.4:95 1.9:95 2.4:10
wing = 0:0 0.4:1 1.9:1 2.4:0
clones = 0:0 0.5:0.6 1.7:0.6 2.2:0
alpha = 0:1 0.5:0.8 1.7:0.8 2.1:1
aura = 0:0 0.5:0.5 1.8:0.5 2.3:0
eyes = 0:open 0.3:wide 2.1:open
fx = 0:none 0.4:ring,0.9 1:ring,0.1 1.05:ring,0.9 1.65:ring,0.1 1.7:none

# Folds itself into a paper plane.
[move fold]
secs = 2.6
speed = 14 0.6 1.9
puff = trail 0.12
dy = 0:0 0.5:5 1.2:6.5 1.9:5 2.4:0 2.6:0
sx = 0:1 0.5:0.45 1.9:0.45 2.3:1
sy = 0:1 0.5:1.1 1.9:1.1 2.3:1
rot = 0:0 0.6:14 1:-10 1.5:14 1.9:0 2.6:0
pivot = 0:0.5
arm1 = 0:10 0.5:80 1.9:80 2.4:10
arm2 = 0:10 0.5:80 1.9:80 2.4:10
wing = 0:0 0.5:1 1.9:1 2.4:0
look = 0:0 0.6:1 1.9:1 2.4:0

# Boils over and goes up on its own steam.
[move boilover]
secs = 2.4
puff = smoke 0.08
dx = 0:0 0.3:0.3 0.36:-0.3 0.42:0.35 0.48:-0.35 0.54:0.4 0.6:-0.4 0.66:0.4 0.72:-0.4 0.78:0.4 0.84:0
dy = 0:0 0.84:0 1.2:6 1.7:6.5 2.2:0 2.4:0
sy = 0:1 0.3:0.94 0.8:0.86 0.95:1.12 1.2:1
arm1 = 0:10 0.8:30 1:120 1.8:120 2.3:10
arm2 = 0:10 0.8:30 1:140 1.8:140 2.3:10
mouth = 0:0 0.8:0.4 1:1 1.8:0.6 2.2:0
aura = 0:0 0.8:0.7 1.6:0.3 2.2:0
eyes = 0:open 0.3:angry 1:wide 2.1:open
fx = 0:none 0.85:jets,0.4 1:jets,1 1.8:jets,0.8 2.15:jets,0.2 2.2:none

# Gathers every colour and lets go of them.
[move prism]
secs = 2.6
puff = spark 0.14
dy = 0:0 0.6:3 2:3 2.6:0
arm1 = 0:10 0.6:88 2.1:88 2.6:10
arm2 = 0:10 0.4:120 1:120 1.15:90 2.1:90 2.6:10
aura = 0:0 0.9:0.5 1.2:1 2:0.6 2.5:0
wing = 0:0 0.6:0.8 2:0.8 2.6:0
eyes = 0:open 0.6:angry 2.2:open
fx = 0:none 0.3:lights,0.1 0.8:lights,1 1.1:lights,1 1.15:rays,0.5 1.4:rays,1 1.7:rays,0.7 2:rays,1 2.1:none

# Falls to crumbs and puts himself together again.
[move crumble]
secs = 3
puff = ash 0.03 0.8 1.7
dx = 0:0 0.5:0.3 0.6:-0.3 0.7:0.3 0.8:-0.3 0.9:0
sy = 0:1 0.8:1 1.6:0.6 2.3:0.6 2.6:1.06 2.8:1
alpha = 0:1 0.9:1 1.6:0 2.2:0 2.6:1
arm1 = 0:10 0.7:70 1.5:20 3:10
arm2 = 0:10 0.7:70 1.5:20 3:10
mouth = 0:0 0.6:0.8 1.4:0.2 3:0
eyes = 0:open 0.4:wide 1.4:closed 2.5:open

