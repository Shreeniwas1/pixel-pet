#include <winver.h>

1 ICON "pixel-pet.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Pixel Pet"
      VALUE "FileDescription", "Pixel Pet - a tiny desktop utility pet"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "InternalName", "pixel-pet"
      VALUE "OriginalFilename", "pixel-pet.exe"
      VALUE "LegalCopyright", "Copyright (C) 2026 Shreeniwas and Veer Pratap Singh"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
